# ServoHIL-I/O Rev.A AD3542R XDC TEMPLATE -- DO NOT USE FOR BITSTREAM
# AD3542R digital interface is 1.8 V in Rev.A.
# Exact PACKAGE_PIN values must come from Vivado I/O Planner.

set_property IOSTANDARD LVCMOS18 [get_ports {dac_sclk dac_ldac_n dac_cs_n[*] dac_alert_n[*]}]
set_property IOSTANDARD LVCMOS18 [get_ports {dac_sdio[*]}]

set_property DRIVE 4 [get_ports {dac_sclk dac_ldac_n dac_cs_n[*]}]
set_property SLEW SLOW [get_ports {dac_sclk dac_ldac_n dac_cs_n[*]}]

# AD3542R Rev.C specifies fSCLK <= 66 MHz.
create_clock -name DAC_SCLK -period 15.152 [get_ports dac_sclk]

# FPGA watchdog service is intentionally on a 3.3 V bank.
set_property IOSTANDARD LVCMOS33 [get_ports fpga_wdi_3v3]

# DAC_RESET_N is not driven directly by the FPGA. It is generated by the external
# fail-safe chain using FPGA_DONE + SEQ_DONE + external watchdog state.
