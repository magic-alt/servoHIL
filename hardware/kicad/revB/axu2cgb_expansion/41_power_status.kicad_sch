(property "Intersheetrefs" "${INTERSHEET_REFS}" (at 340.36 175.26 0) (effects (font (size 1.27 1.27)) hide))) (text "HIL_ARM is generated by the powered HOST, NOT an expansion rail. Q401 defaults ON while HOST requests ARM." (at 25.4 218.44 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "8462bbd0-324d-5dfb-8333-7b379cd76d4e")) (text "Only a power-qualified ARM_LATCH turns Q402 on and releases Q401. Board power lost -> Q402 off -> Q401 reports fault." (at 25.4 228.6 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "65213e00-e470-5b5c-9a1f-de37f10abf07")) (text "HIL_FAULT_N=HIGH means power-qualified AND armed; LOW also means disarmed. At HOST off, no expansion supply drives this pin high." (at 25.4 238.76 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "bbcce28b-30c7-569d-be76-15ea524d54c7")) (text "Nominal fault sink <0.33mA and HOST ARM total load <0.4mA. Check transient/partial-power behavior physically; not certified safety." (at 25.4 248.92 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "dc07e35a-e1d1-5f65-8248-05337a66423b")) (text "Other direct DAC/ADC pins STILL require power-off backfeed protection. This diagnostic alone does not authorize hot plugging." (at 25.4 259.08 0) (effects (font (size 1.27 1.27)) (justify left bottom)) (uuid "c1e53884-9896-5022-a0f9-f60373dd3d87"))
)
