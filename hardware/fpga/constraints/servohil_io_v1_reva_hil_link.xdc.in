# ServoHIL-I/O V1 Rev.A HIL-Link XDC template
# PACKAGE_PIN fields are intentionally not populated until Vivado I/O planning is frozen.
# All HIL-Link signals on the Local FPGA side are LVCMOS18.

set_property IOSTANDARD LVCMOS18 [get_ports {hl_tx_clk hl_rx_clk hl_sync hl_irq hl_safe_n hl_reset_n hl_heartbeat}]
set_property IOSTANDARD LVCMOS18 [get_ports {hl_tx[*]}]
set_property IOSTANDARD LVCMOS18 [get_ports {hl_rx[*]}]

# Conservative edge rate until SI review says otherwise.
set_property SLEW SLOW [get_ports {hl_tx_clk hl_irq}]
set_property SLEW SLOW [get_ports {hl_rx[*]}]

# Example timing intent; exact input/output delays require measured/estimated board flight time.
#create_clock -name HIL_TX_CLK -period 10.000 [get_ports hl_tx_clk]
#create_clock -name HIL_RX_CLK -period 10.000 [get_ports hl_rx_clk]

# TODO:
# 1. assign PACKAGE_PINs after bank escape review,
# 2. add set_input_delay/set_output_delay for DDR data,
# 3. verify source-synchronous capture with IDELAY/ISERDES only if required,
# 4. cross-check every net against docs/icd/ServoHIL_IO_V1_RevA_J12_HIL_Link_ICD.csv.
