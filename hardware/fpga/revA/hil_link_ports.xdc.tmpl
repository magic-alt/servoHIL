# ServoHIL-I/O Rev.A HIL-Link XDC TEMPLATE -- DO NOT USE FOR BITSTREAM
# Exact XC7A35T FGG484 PACKAGE_PIN values remain UNASSIGNED until Vivado I/O Planner review.
#
# Direction is from the Local I/O FPGA point of view:
#   hl_tx_* : ZU2CG -> Local FPGA
#   hl_rx_* : Local FPGA -> ZU2CG

set_property IOSTANDARD LVCMOS18 [get_ports {hl_tx_clk hl_rx_clk}]
set_property IOSTANDARD LVCMOS18 [get_ports {hl_tx_data[*] hl_rx_data[*]}]
set_property IOSTANDARD LVCMOS18 [get_ports {hl_sync hl_irq hl_safe_n hl_reset_n hl_heartbeat}]
set_property IOSTANDARD LVCMOS18 [get_ports {trig[*] dbg[*] spare[*] spare_gc[*]}]

# Local-FPGA-driven deterministic outputs. Keep edge rate conservative until SI measurement.
set_property DRIVE 4 [get_ports {hl_rx_clk hl_rx_data[*] hl_irq}]
set_property SLEW SLOW [get_ports {hl_rx_clk hl_rx_data[*] hl_irq}]

# The incoming ZU2CG source-synchronous clock is 100 MHz.
create_clock -name HIL_TX_CLK -period 10.000 [get_ports hl_tx_clk]

